# MongoDB connection string (MongoDB Atlas in production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Secret used to sign/verify JWTs - use a long random string, never reuse across environments
JWT_SECRET=replace_with_a_long_random_secret

# Groq API key (server-side only - never expose this to the frontend)
GROQ_API_KEY=your_groq_api_key

# Groq model used for the AI chat assistant
GROQ_MODEL=openai/gpt-oss-20b

# Port the Express server listens on
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
# e.g. http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173
