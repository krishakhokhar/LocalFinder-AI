# ===========================================================================
# LocalFinder-AI - backend environment
# Copy to backend/.env and fill in. Never commit the real .env.
# ===========================================================================

# --- Required ---------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas in production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# Paste the string from Atlas (Database > Connect > Drivers) and replace every
# <placeholder>, including <db_password> - the server refuses to boot while any
# are left in. URL-encode : / ? # [ ] @ if the password contains them.

# Secret used to sign/verify JWTs. Use 32+ random characters and never reuse
# it across environments. The server refuses to boot if this is too short.
JWT_SECRET=replace_with_a_long_random_secret

# --- Core -------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# development | production  (production turns on rate limiting, hides error
# details from responses and disables automatic index building)
NODE_ENV=development

# How long an issued token stays valid (zeit/ms format: 15m, 12h, 7d)
JWT_EXPIRES_IN=7d

# Comma-separated extra frontend origins allowed by CORS. localhost:5173 and
# the production Vercel domain are always allowed; this adds to that list.
CORS_ORIGIN=http://localhost:5173

# error | warn | info | debug
LOG_LEVEL=debug

# Only for mongodb+srv:// URIs. The SRV lookup they need uses the resolver
# bundled inside Node, not the operating system one, and on some networks
# (VPNs, captive portals, NAT64/DNS64 campus Wi-Fi) it finds no DNS server and
# fails with "querySrv ECONNREFUSED" even though everything else online works.
# The server detects that and retries through 1.1.1.1, 8.8.8.8 and 9.9.9.9;
# set this to use different resolvers. Record lookups only - ordinary sockets
# keep using the OS resolver either way.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Set to "true" to exercise rate limiting outside production
# ENABLE_RATE_LIMIT=false

# --- AI (Groq) --------------------------------------------------------------

# Server-side only. Never expose this to the frontend. Without it, AI search
# and chat degrade gracefully instead of failing.
GROQ_API_KEY=your_groq_api_key

# Model used for the assistant and for structured intent extraction
GROQ_MODEL=openai/gpt-oss-20b

# --- Image uploads ----------------------------------------------------------

# local | cloudinary
# "local" writes to UPLOAD_DIR and is fine for development. Render's disk is
# ephemeral, so production should use cloudinary.
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=3145728

# Required only when UPLOAD_DRIVER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=localfinder

# Public base URL of this API, used to build absolute URLs for locally
# stored uploads (e.g. https://localfinder-ai.onrender.com)
PUBLIC_URL=http://localhost:5000

# Development only: let the API boot even if MongoDB is unreachable, so the
# frontend can be worked on without a database. Category metadata and live
# OpenStreetMap search keep working; anything that reads or writes stored
# data (accounts, reviews, bookings) will fail. Ignored when NODE_ENV=production.
# ALLOW_START_WITHOUT_DB=false

# Appointment reminders + stale-booking cleanup run in-process every 15
# minutes. Set to false if you run more than one instance, and drive the
# sweep from a platform cron job instead so the work is not duplicated.
# ENABLE_REMINDERS=true
