# Copy to .env (local) and set the same variables in your Vercel project
# settings (production). .env is gitignored; this file is not, so it must
# never contain a real key.

# --- Backend API -----------------------------------------------------------
# Base URL of the backend API, no trailing slash.
VITE_API_URL=https://localfinder-ai.onrender.com
# Local development override:
# VITE_API_URL=http://localhost:5000

# --- CARTO Basemaps --------------------------------------------------------
# Powers the "Light" map style. CARTO requires a key: without one every tile
# comes back stamped "API KEY REQUIRED" (as HTTP 200, so it cannot be
# detected as a network error), and the app falls back to standard
# OpenStreetMap tiles.
#
# Free key: https://carto.com/basemaps/apikey
#
# This key is PUBLISHABLE - it ships in the browser bundle and is visible in
# devtools. Secrecy is not the protection; DOMAIN RESTRICTION is. Create two
# separate keys in the CARTO dashboard and restrict each one:
#
#   local key       -> allowed domain: localhost        -> put in .env
#   production key  -> allowed domain: your Vercel host -> put in Vercel env vars
#
# Keeping them separate means a leaked production key cannot be used locally
# and revoking one never breaks the other.
VITE_CARTO_API_KEY=your_carto_basemaps_key_here
